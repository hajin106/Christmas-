    /* =========================================================================
       6. 순수 HTML5 Canvas 기반 고화질 판결문 PNG 이미지 생성 & 다운로드
          (외부 라이브러리 CORS 이슈 없이 100% 오프라인/깃허브 호환)
    ========================================================================= */
    function wrapCanvasText(ctx, text, x, y, maxWidth, lineHeight) {
      const words = text.split(' ');
      let line = '';
      let currentY = y;

      for (let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = ctx.measureText(testLine);
        if (metrics.width > maxWidth && n > 0) {
          ctx.fillText(line.trim(), x, currentY);
          line = words[n] + ' ';
          currentY += lineHeight;
        } else {
          line = testLine;
        }
      }
      ctx.fillText(line.trim(), x, currentY);
      return currentY + lineHeight;
    }

    function drawRoundRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }

    function downloadReportImage() {
      if (!latestJudgmentData) return;
      playTone(660, 0.08, 'triangle', 0.1, 0);
      playTone(880, 0.14, 'triangle', 0.1, 0.08);

      const canvas = document.getElementById('export-canvas');
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;
      const d = latestJudgmentData;

      // 배경 다크 그린
      ctx.fillStyle = '#0B1913';
      ctx.fillRect(0, 0, W, H);

      // 메인 카드 영역
      drawRoundRect(ctx, 32, 32, W - 64, H - 64, 28);
      ctx.fillStyle = '#12291F';
      ctx.fill();
      ctx.lineWidth = 6;
      ctx.strokeStyle = '#E5C158';
      ctx.stroke();

      // 내부 얇은 골드 보더
      drawRoundRect(ctx, 48, 48, W - 96, H - 96, 20);
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = 'rgba(229, 193, 88, 0.35)';
      ctx.stroke();

      // 상단 타이틀
      ctx.textAlign = 'center';
      ctx.fillStyle = '#F3D06B';
      ctx.font = 'bold 28px "Press Start 2P", monospace';
      ctx.fillText('OFFICIAL JUDGMENT', W / 2, 115);
      ctx.fillText('REPORT', W / 2, 152);

      ctx.fillStyle = '#B7CEC2';
      ctx.font = '600 18px "Galmuri11", sans-serif';
      ctx.fillText('NORTH POLE  ·  CONFIDENTIAL', W / 2, 190);

      // 구분선 1
      ctx.strokeStyle = '#E5C158';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(80, 222);
      ctx.lineTo(W - 80, 222);
      ctx.stroke();

      // 피고인 & 최종 점수
      ctx.textAlign = 'left';
      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 28px "Galmuri11", sans-serif';
      ctx.fillText(`피고인: ${d.name}`, 84, 276);
      ctx.fillText(`최종 점수: ${d.score} / 80`, 84, 324);

      // 등급 박스
      drawRoundRect(ctx, 80, 354, W - 160, 148, 16);
      ctx.fillStyle = '#0A1711';
      ctx.fill();
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'rgba(229, 193, 88, 0.35)';
      ctx.stroke();

      // 스탬프 배지
      drawRoundRect(ctx, 104, 376, 300, 38, 8);
      ctx.fillStyle = d.tier.badgeBg;
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = d.tier.badgeBorder;
      ctx.stroke();

      ctx.fillStyle = d.tier.badgeText;
      ctx.font = 'bold 14px "Press Start 2P", monospace';
      ctx.fillText(d.tier.badge, 118, 401);

      // 등급명 & 설명
      ctx.fillStyle = '#FFFFFF';
      ctx.font = 'bold 28px "Galmuri11", sans-serif';
      ctx.fillText(`${d.tier.emoji} ${d.tier.title}`, 104, 452);

      ctx.fillStyle = '#B7CEC2';
      ctx.font = '20px "Galmuri11", sans-serif';
      ctx.fillText(d.tier.desc, 104, 484);

      // 주요 죄목
      ctx.fillStyle = '#F3D06B';
      ctx.font = 'bold 24px "Galmuri11", sans-serif';
      ctx.fillText('📋 주요 죄목', 84, 554);

      ctx.fillStyle = '#FFFFFF';
      ctx.font = '22px "Galmuri11", sans-serif';
      d.crimes.forEach((crime, i) => {
        ctx.fillText(`${i + 1}. ${crime}`, 94, 598 + i * 38);
      });

      // 구분선 2
      ctx.strokeStyle = '#E5C158';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(80, 725);
      ctx.lineTo(W - 80, 725);
      ctx.stroke();

      // 산타의 최종 판결
      ctx.fillStyle = '#F3D06B';
      ctx.font = 'bold 24px "Galmuri11", sans-serif';
      ctx.fillText('⚖️ 산타의 최종 판결', 84, 770);

      ctx.fillStyle = '#F4EFE6';
      ctx.font = '21px "Galmuri11", sans-serif';
      let nextY = wrapCanvasText(ctx, d.comment1, 84, 812, W - 168, 32);

      ctx.fillStyle = '#F3D06B';
      ctx.font = 'bold 22px "Galmuri11", sans-serif';
      ctx.fillText(d.comment2, 84, nextY + 12);

      ctx.fillStyle = '#C8DDD2';
      ctx.font = 'italic 21px "Galmuri11", sans-serif';
      ctx.fillText(d.comment3, 84, nextY + 48);

      // 하단 서명
      ctx.textAlign = 'center';
      ctx.fillStyle = '#A3C2B3';
      ctx.font = '600 18px "Galmuri11", sans-serif';
      ctx.fillText('SANTA CLAUS  ·  CHIEF INVESTIGATOR', W / 2, H - 72);

      // 다운로드 트리거
      try {
        const dataUrl = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = `Santas_Blacklist_${d.name}.png`;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showToast('📸 판결문 이미지가 저장되었습니다!');
      } catch (err) {
        showToast('⚠️ 이미지 저장 중 오류가 발생했습니다.');
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast-msg');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2600);
    }

    /* =========================================================================
       7. 배경 눈 내리는 파티클 Canvas 애니메이션
    ========================================================================= */
    function initSnowParticles() {
      const canvas = document.getElementById('snow-canvas');
      const ctx = canvas.getContext('2d');
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const flakeCount = Math.min(75, Math.floor(width / 8));
      const flakes = Array.from({ length: flakeCount }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 2.4 + 1,
        speedY: Math.random() * 0.9 + 0.35,
        speedX: (Math.random() - 0.5) * 0.4,
        alpha: Math.random() * 0.6 + 0.25
      }));

      function animateSnow() {
        ctx.clearRect(0, 0, width, height);
        flakes.forEach(f => {
          f.y += f.speedY;
          f.x += f.speedX;
          if (f.y > height) {
            f.y = -5;
            f.x = Math.random() * width;
          }
          if (f.x > width) f.x = 0;
          if (f.x < 0) f.x = width;

          ctx.fillStyle = `rgba(255, 255, 255, ${f.alpha})`;
          // 픽셀 감성을 위해 사각 도트 눈송이로 렌더링
          ctx.fillRect(Math.floor(f.x), Math.floor(f.y), Math.ceil(f.r), Math.ceil(f.r));
        });
        requestAnimationFrame(animateSnow);
      }

      animateSnow();
    }

    window.addEventListener('load', () => {
      initSnowParticles();
    });
  </script>
