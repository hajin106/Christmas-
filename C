    function handleChoiceSelect(choiceIdx, clickedBtn) {
      if (hasAnsweredCurrent) return;
      hasAnsweredCurrent = true;

      const qData = QUESTIONS[currentQuestionIndex];
      const choice = qData.choices[choiceIdx];

      // 점수 및 기록 저장
      totalScore += choice.score;
      selectedRecords.push({
        qId: qData.id,
        choiceText: choice.text,
        score: choice.score,
        crime: choice.crime
      });

      // 효과음 재생
      playSelectSound(choice.score);

      // 버튼 상태 업데이트
      const allBtns = document.querySelectorAll('#choices-container .choice-btn');
      allBtns.forEach(btn => {
        btn.disabled = true;
      });
      clickedBtn.classList.add('selected');

      // 산타 표정, 반응 대사, 상태 태그 즉시 업데이트
      setSantaMood(choice.mood);
      document.getElementById('santa-dialogue').textContent = `"${choice.reaction}"`;

      const statusTag = document.getElementById('santa-status-tag');
      statusTag.textContent = `[${choice.tag}]`;
      statusTag.style.backgroundColor = choice.tagColor;
      statusTag.classList.remove('hidden');

      // 산타 캐릭터 살짝 흔들림 피드백
      if (choice.score >= 8) {
        const santaChar = document.getElementById('santa-character');
        santaChar.classList.remove('animate-shake');
        void santaChar.offsetWidth;
        santaChar.classList.add('animate-shake');
      }

      // 다음 질문 / 최종 판결 보기 버튼 활성화
      const nextWrap = document.getElementById('next-action-wrap');
      const nextBtnText = document.getElementById('next-btn-text');
      if (currentQuestionIndex < QUESTIONS.length - 1) {
        nextBtnText.textContent = '다음 질문으로';
      } else {
        nextBtnText.textContent = '최종 판결 확인하기';
      }
      nextWrap.classList.remove('hidden');
    }

