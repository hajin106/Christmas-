          <span class="choice-badge">${choice.label}</span>
          <span class="font-bold text-sm sm:text-[15px] leading-snug">${choice.text}</span>
        `;
        btn.onclick = () => handleChoiceSelect(cIdx, btn);
        choicesContainer.appendChild(btn);
