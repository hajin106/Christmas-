<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>SANTA'S BLACKLIST | NORTH POLE · SECURITY DIVISION</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- 레트로 픽셀 & 한글 폰트 로드 -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/galmuri/dist/galmuri.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" rel="stylesheet">

  <style>
    :root {
      --bg-dark: #0A1711;
      --bg-green: #10241B;
      --gold: #E5C158;
      --gold-light: #F3D06B;
      --cream: #FDF3DF;
      --cream-dark: #F7E8C8;
      --red: #B8292F;
      --red-bright: #D63638;
      --ink: #241914;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-dark);
      background-image:
        radial-gradient(circle at 50% 0%, #193829 0%, #0A1711 75%);
      color: #F4EFE6;
      font-family: 'Galmuri11', 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .font-pixel-en {
      font-family: 'Press Start 2P', monospace;
      letter-spacing: 0.04em;
    }

    .font-pixel-kr {
      font-family: 'Galmuri11', monospace;
    }

    .font-clean {
      font-family: 'Pretendard', sans-serif;
    }

    /* 배경 눈 파티클 캔버스 */
    #snow-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    /* 메인 앱 컨테이너 */
    .app-shell {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      background: linear-gradient(180deg, #10241B 0%, #0C1C15 100%);
      border-left: 2px solid rgba(229, 193, 88, 0.25);
      border-right: 2px solid rgba(229, 193, 88, 0.25);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.85);
      display: flex;
      flex-direction: column;
      padding: 16px 16px 28px;
    }

    /* 픽셀 테두리 & 입체 버튼 */
    .pixel-box {
      border: 3px solid #2A1D15;
      box-shadow:
        inset 0 0 0 2px rgba(255, 255, 255, 0.15),
        0 4px 0 #07100C;
    }

    .btn-red {
      background: linear-gradient(180deg, #D63638 0%, #B8292F 100%);
      border: 3px solid #3B1012;
      box-shadow:
        inset 0 2px 0 rgba(255, 255, 255, 0.35),
        0 4px 0 #5C1215;
      color: #FFFDF9;
      transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.15s ease;
    }

    .btn-red:hover {
      filter: brightness(1.06);
    }

    .btn-red:active {
      transform: translateY(3px);
      box-shadow:
        inset 0 2px 0 rgba(255, 255, 255, 0.25),
        0 1px 0 #5C1215;
    }

    .btn-gold {
      background: linear-gradient(180deg, #F3D06B 0%, #D9AC3B 100%);
      border: 3px solid #3D2B08;
      box-shadow:
        inset 0 2px 0 rgba(255, 255, 255, 0.5),
        0 4px 0 #6B4D10;
      color: #231704;
      transition: transform 0.08s ease, box-shadow 0.08s ease, filter 0.15s ease;
    }

    .btn-gold:hover {
      filter: brightness(1.05);
    }

    .btn-gold:active {
      transform: translateY(3px);
      box-shadow:
        inset 0 2px 0 rgba(255, 255, 255, 0.3),
        0 1px 0 #6B4D10;
    }

    /* 캔디케인 줄무늬 테두리 카드 */
    .candycane-frame {
      padding: 8px;
      background: repeating-linear-gradient(
        -45deg,
        #C92A2F,
        #C92A2F 12px,
        #FDF3DF 12px,
        #FDF3DF 24px
      );
      border-radius: 16px;
      border: 3px solid #2A1612;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.55);
      position: relative;
    }

    .candycane-inner {
      background: #12291F;
      border: 3px solid #2A1612;
      border-radius: 10px;
      padding: 18px 14px 16px;
    }

    /* 선택지 버튼 */
    .choice-btn {
      background: linear-gradient(180deg, #FDF3DF 0%, #F4E2BE 100%);
      border: 3px solid #3A2618;
      box-shadow:
        inset 0 2px 0 #FFFFFF,
        0 3px 0 #26180E;
      color: #241914;
      border-radius: 12px;
      transition: all 0.12s ease;
      text-align: left;
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      cursor: pointer;
    }

    .choice-btn:hover:not(:disabled) {
      transform: translateY(-1px);
      background: linear-gradient(180deg, #FFF9EC 0%, #F9E9C8 100%);
      border-color: #B8292F;
    }

    .choice-btn:active:not(:disabled) {
      transform: translateY(2px);
      box-shadow: 0 1px 0 #26180E;
    }

    .choice-btn.selected {
      background: linear-gradient(180deg, #FFE4A3 0%, #F3C65F 100%);
      border-color: #B8292F;
      box-shadow: 0 0 0 2px #B8292F, 0 3px 0 #26180E;
    }

    .choice-btn:disabled {
      opacity: 0.65;
      cursor: default;
    }

    .choice-badge {
      width: 30px;
      height: 30px;
      min-width: 30px;
      background: #B8292F;
      border: 2px solid #3B1012;
      color: #FFFDF9;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Press Start 2P', monospace;
      font-size: 12px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }

    /* 크림색 말풍선 */
    .speech-bubble {
      background: #FDF3DF;
      border: 3px solid #2E1F14;
      border-radius: 14px;
      color: #241914;
      position: relative;
      box-shadow: 0 5px 0 rgba(0, 0, 0, 0.45);
    }

    .speech-bubble::before {
      content: '';
      position: absolute;
      left: -13px;
      top: 28px;
      width: 0;
      height: 0;
      border-top: 10px solid transparent;
      border-bottom: 10px solid transparent;
      border-right: 13px solid #2E1F14;
    }

    .speech-bubble::after {
      content: '';
      position: absolute;
      left: -9px;
      top: 30px;
      width: 0;
      height: 0;
      border-top: 8px solid transparent;
      border-bottom: 8px solid transparent;
      border-right: 10px solid #FDF3DF;
    }

    /* 갈색 종이 테이프 메모 배지 */
    .suspect-tape {
      background: #D7B484;
      border: 2px solid #4A351E;
      color: #26180A;
      position: relative;
      box-shadow: 0 3px 0 rgba(0,0,0,0.4);
      transform: rotate(-1.5deg);
    }

    .suspect-tape::before,
    .suspect-tape::after {
      content: '';
      position: absolute;
      width: 14px;
      height: 7px;
      background: rgba(255, 248, 225, 0.65);
      border: 1px solid rgba(74, 53, 30, 0.35);
    }
    .suspect-tape::before {
      top: -4px;
      left: -5px;
      transform: rotate(-35deg);
    }
    .suspect-tape::after {
      bottom: -4px;
      right: -5px;
      transform: rotate(-35deg);
    }

    /* 애니메이션 키프레임 */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-7px); }
      40% { transform: translateX(7px); }
      60% { transform: translateX(-5px); }
      80% { transform: translateX(5px); }
    }
    .animate-shake {
      animation: shake 0.38s ease-in-out;
    }

    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-3px); }
    }
    .animate-float {
      animation: floatSlow 2.6s ease-in-out infinite;
    }

    @keyframes neonPulse {
      0%, 100% { opacity: 1; filter: drop-shadow(0 0 6px #FF4D4D); }
      50% { opacity: 0.72; filter: drop-shadow(0 0 2px #FF4D4D); }
    }
    .neon-rudolph {
      animation: neonPulse 2.2s infinite ease-in-out;
    }

    @keyframes bulbBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }
    .bulb-1 { animation: bulbBlink 1.4s infinite 0s; }
    .bulb-2 { animation: bulbBlink 1.4s infinite 0.45s; }
    .bulb-3 { animation: bulbBlink 1.4s infinite 0.9s; }

    @keyframes stampSlam {
      0% { transform: scale(2.4) rotate(-18deg); opacity: 0; }
      70% { transform: scale(0.92) rotate(-6deg); opacity: 1; }
      100% { transform: scale(1) rotate(-8deg); opacity: 1; }
    }
    .stamp-anim {
      animation: stampSlam 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    @keyframes popIn {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .pop-in {
      animation: popIn 0.28s ease-out forwards;
    }

    /* 스노우볼 내부 눈 애니메이션 */
    @keyframes snowGlobeFall {
      0% { transform: translateY(-14px); opacity: 0; }
      30% { opacity: 1; }
      100% { transform: translateY(16px); opacity: 0; }
    }
    .sg-flake-1 { animation: snowGlobeFall 2.2s linear infinite 0s; }
    .sg-flake-2 { animation: snowGlobeFall 2.6s linear infinite 0.7s; }
    .sg-flake-3 { animation: snowGlobeFall 2.0s linear infinite 1.3s; }
    .sg-flake-4 { animation: snowGlobeFall 2.4s linear infinite 1.8s; }

    /* 공식 판결 보고서 스타일 */
    .report-card {
      background: linear-gradient(180deg, #132A20 0%, #0E2018 100%);
      border: 3px solid #E5C158;
      border-radius: 18px;
      box-shadow:
        0 0 0 3px #0A1711,
        0 12px 30px rgba(0, 0, 0, 0.75);
      position: relative;
      overflow: hidden;
    }

    .report-card::before {
      content: '';
      position: absolute;
      inset: 6px;
      border: 1px solid rgba(229, 193, 88, 0.28);
      border-radius: 12px;
      pointer-events: none;
    }

    /* Toast 메시지 */
    #toast-msg {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(80px);
      background: #FDF3DF;
      color: #241914;
      border: 3px solid #B8292F;
      padding: 10px 18px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      z-index: 100;
      box-shadow: 0 6px 20px rgba(0,0,0,0.6);
      transition: transform 0.25s ease;
      pointer-events: none;
      white-space: nowrap;
    }
    #toast-msg.show {
      transform: translateX(-50%) translateY(0);
    }
  </style>
</head>
<body>
  <!-- 배경 눈 내리는 파티클 -->
  <canvas id="snow-canvas"></canvas>

  <!-- 토스트 알림 -->
  <div id="toast-msg">판결문이 이미지로 저장되었습니다!</div>

  <!-- 메인 앱 컨테이너 -->
  <main class="app-shell">
    <!-- 상단 유틸리티 바 (사운드 토글) -->
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-1.5 text-[11px] text-[#A3C2B3] tracking-wider">
        <span class="inline-block w-2 h-2 rounded-full bg-[#4ADE80] animate-pulse"></span>
        <span>NORTH POLE HQ · SEC-DIV</span>
      </div>
      <button
        id="sound-toggle-btn"
        onclick="toggleSound()"
        class="px-2.5 py-1 rounded-lg bg-[#183427] border border-[#E5C158]/40 text-[#E5C158] text-xs flex items-center gap-1 hover:bg-[#204433] transition"
        title="효과음 켜기/끄기"
      >
        <span id="sound-icon">🔊</span>
        <span id="sound-label" class="text-[11px]">SFX ON</span>
      </button>
    </div>

    <!-- =========================================================
         1. 신원 확인 화면 (START SCREEN)
    ========================================================== -->
    <section id="screen-start" class="flex-1 flex flex-col justify-between pop-in">
      <div class="text-center mt-1">
        <h1 class="font-pixel-en text-[#F3D06B] text-[20px] sm:text-[23px] leading-snug drop-shadow-[0_3px_0_#3A2606]">
          SANTA'S BLACKLIST
        </h1>
        <p class="text-[11px] sm:text-xs tracking-[0.22em] text-[#C8DDD2] mt-1.5 font-semibold">
          NORTH POLE · SECURITY DIVISION
        </p>

        <div class="mt-4">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            신원 확인 절차
          </h2>
          <p class="text-xs sm:text-[13px] text-[#B7CEC2] mt-1">
            올해 당신의 행동을 조사하기 위해 신원 확인이 필요합니다.
          </p>
        </div>
      </div>

      <!-- 중앙 비주얼: 픽셀/레트로 감성 SVG 탐정 산타 사무소 일러스트 -->
      <div class="my-4 rounded-2xl overflow-hidden border-[3px] border-[#2E1F14] shadow-[0_8px_24px_rgba(0,0,0,0.65)] bg-[#14251E] relative">
        <svg viewBox="0 0 440 265" class="w-full h-auto block" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1A2F26"/>
              <stop offset="100%" stop-color="#0F1D17"/>
            </linearGradient>
            <linearGradient id="lampGlow" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFE699" stop-opacity="0.45"/>
              <stop offset="100%" stop-color="#FFE699" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="nightSky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#08131E"/>
              <stop offset="100%" stop-color="#13293D"/>
            </linearGradient>
          </defs>

          <!-- 어두운 나무 벽지 -->
          <rect width="440" height="265" fill="url(#wallGrad)"/>
          <!-- 세로 나무 패널 라인 -->
          <g stroke="#0B1611" stroke-width="2" opacity="0.55">
            <line x1="40" y1="0" x2="40" y2="210"/>
            <line x1="80" y1="0" x2="80" y2="210"/>
            <line x1="120" y1="0" x2="120" y2="210"/>
            <line x1="160" y1="0" x2="160" y2="210"/>
            <line x1="200" y1="0" x2="200" y2="210"/>
            <line x1="240" y1="0" x2="240" y2="210"/>
          </g>

          <!-- 우측 창문 (눈 내리는 밤 + 루돌프 네온사인) -->
          <g transform="translate(262, 16)">
            <rect x="0" y="0" width="156" height="135" rx="4" fill="#2A1A12" stroke="#140C08" stroke-width="3"/>
            <rect x="8" y="8" width="140" height="119" fill="url(#nightSky)"/>
            <!-- 블라인드 상단 -->
            <g fill="#4A3222" opacity="0.85">
              <rect x="8" y="8" width="140" height="4"/>
              <rect x="8" y="15" width="140" height="4"/>
              <rect x="8" y="22" width="140" height="4"/>
            </g>
            <!-- 눈 덮인 전나무 실루엣 -->
            <polygon points="32,127 46,92 60,127" fill="#17382C"/>
            <polygon points="36,108 46,84 56,108" fill="#E6F2F8"/>
            <polygon points="108,127 124,86 140,127" fill="#17382C"/>
            <polygon points="113,104 124,78 135,104" fill="#E6F2F8"/>
            <!-- 루돌프 네온사인 -->
            <g class="neon-rudolph" transform="translate(64, 34)" stroke="#FF5A5F" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <!-- 몸통 & 다리 -->
              <path d="M12,34 L34,34 L40,22 L48,22"/>
              <path d="M14,34 L10,50 M20,34 L22,49 M32,34 L30,50 M36,34 L42,48"/>
              <!-- 목 & 머리 -->
              <path d="M34,34 L42,16 L52,18 L48,24 L40,22"/>
              <!-- 뿔 -->
              <path d="M42,16 L38,6 M40,10 L34,9 M45,16 L47,5 M46,10 L52,8"/>
              <!-- 빨간 코 점 -->
              <circle cx="53" cy="19" r="2.2" fill="#FF2A2A" stroke="none"/>
            </g>
            <!-- 창틀 십자 -->
            <rect x="75" y="8" width="6" height="119" fill="#2A1A12"/>
            <rect x="8" y="65" width="140" height="6" fill="#2A1A12"/>
            <!-- 창밖 눈송이 -->
            <g fill="#FFFFFF" opacity="0.8">
              <circle cx="24" cy="40" r="1.5"/><circle cx="48" cy="60" r="1.5"/>
              <circle cx="115" cy="35" r="1.5"/><circle cx="95" cy="85" r="1.5"/>
              <circle cx="30" cy="95" r="1.2"/><circle cx="130" cy="70" r="1.5"/>
            </g>
          </g>

          <!-- 좌측 코르크 증거 보드 -->
          <g transform="translate(18, 16)">
            <rect x="0" y="0" width="218" height="118" rx="4" fill="#8C5832" stroke="#3B2212" stroke-width="4"/>
            <rect x="6" y="6" width="206" height="106" fill="#A66B3E"/>
            <!-- 보드 위 전구 줄 -->
            <path d="M6,10 Q109,22 212,10" stroke="#241914" stroke-width="2" fill="none"/>
            <circle cx="30" cy="14" r="3.5" fill="#FFE066" class="bulb-1"/>
            <circle cx="75" cy="17" r="3.5" fill="#FF6B6B" class="bulb-2"/>
            <circle cx="125" cy="17" r="3.5" fill="#69DB7C" class="bulb-3"/>
            <circle cx="175" cy="14" r="3.5" fill="#FFE066" class="bulb-1"/>

            <!-- 증거 메모지들 -->
            <g transform="translate(16, 26) rotate(-3)">
              <rect width="48" height="24" fill="#FDF3DF" stroke="#4A3525" stroke-width="1"/>
              <circle cx="24" cy="3" r="2" fill="#D63638"/>
              <text x="24" y="13" font-size="5.5" font-weight="bold" fill="#241914" text-anchor="middle">COOKIE</text>
              <text x="24" y="20" font-size="5" fill="#B8292F" text-anchor="middle">HEIST #04</text>
            </g>

            <g transform="translate(76, 22) rotate(2)">
              <rect width="42" height="34" fill="#FFFDF9" stroke="#4A3525" stroke-width="1"/>
              <rect x="6" y="5" width="30" height="20" fill="#2B4C7E"/>
              <circle cx="21" cy="14" r="6" fill="#FFD8B1"/>
              <text x="21" y="31" font-size="5" font-weight="bold" fill="#241914" text-anchor="middle">SUSPECT</text>
            </g>

            <g transform="translate(132, 28) rotate(-2)">
              <rect width="58" height="26" fill="#FDF3DF" stroke="#4A3525" stroke-width="1"/>
              <circle cx="29" cy="3" r="2" fill="#D63638"/>
              <text x="29" y="13" font-size="5.5" font-weight="bold" fill="#241914" text-anchor="middle">SPILLED MILK</text>
              <text x="29" y="21" font-size="5" fill="#555" text-anchor="middle">CASE CLOSED</text>
            </g>

            <!-- 증거 연결 빨간 실 -->
            <polyline points="40,38 97,39 160,41 112,78 52,75" fill="none" stroke="#D63638" stroke-width="1.3" stroke-dasharray="3,2"/>

            <!-- 하단 메모 & 쿠키 증거 -->
            <g transform="translate(24, 62) rotate(2)">
              <rect width="48" height="28" fill="#F7E8C8" stroke="#4A3525" stroke-width="1"/>
              <text x="24" y="13" font-size="5.5" font-weight="bold" fill="#B8292F" text-anchor="middle">ALARM</text>
              <text x="24" y="21" font-size="5" fill="#241914" text-anchor="middle">SNOOZED x9</text>
            </g>

            <!-- 초코칩 쿠키 아이콘 -->
            <g transform="translate(96, 68)">
              <circle cx="14" cy="14" r="13" fill="#C68642" stroke="#5C3A18" stroke-width="1.5"/>
              <circle cx="9" cy="10" r="2" fill="#3B200D"/>
              <circle cx="18" cy="9" r="2.2" fill="#3B200D"/>
              <circle cx="14" cy="18" r="2" fill="#3B200D"/>
              <circle cx="20" cy="17" r="1.6" fill="#3B200D"/>
            </g>

            <!-- 지팡이 사탕 증거 -->
            <g transform="translate(154, 62) rotate(12)">
              <path d="M10,32 L10,12 A7,7 0 0,1 24,12 L24,16" fill="none" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"/>
              <path d="M10,32 L10,12 A7,7 0 0,1 24,12 L24,16" fill="none" stroke="#D63638" stroke-width="5" stroke-dasharray="4,4" stroke-linecap="round"/>
            </g>
          </g>

          <!-- 책상 스탠드 램프 & 빛 원뿔 -->
