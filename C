        santaLine.textContent = '"이름도 안 대고 도망갈 셈인가? 자네, 시작부터 수상하군!"';
        santaLine.classList.add('text-[#FF9E9E]');
        moodBadge.classList.remove('hidden');

        wrapper.classList.remove('animate-shake');
        void wrapper.offsetWidth;
        wrapper.classList.add('animate-shake');
        inputEl.focus();
        return;
      }

      suspectName = rawName;
      currentQuestionIndex = 0;
      totalScore = 0;
      selectedRecords = [];
      hasAnsweredCurrent = false;

      playTone(523.25, 0.08, 'square', 0.08, 0);
      playTone(783.99, 0.14, 'square', 0.08, 0.08);

      document.getElementById('display-suspect-name').textContent = suspectName;
